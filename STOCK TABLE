public void loadStock() {
    String sql = "SELECT id, item_name, quantity, unit, minimum_stock, price, date_added FROM inventory WHERE archived = 0";

    try (Connection con = DatabaseConnection.getConnection();
         PreparedStatement pst = con.prepareStatement(sql);
         ResultSet rs = pst.executeQuery()) {

        DefaultTableModel model =
            (DefaultTableModel) jTable1.getModel();

        model.setRowCount(0);

        while (rs.next()) {
            int quantity = rs.getInt("quantity");
            int minimum = rs.getInt("minimum_stock");
            java.sql.Date date = rs.getDate("date_added");

            String status = quantity == 0 ? "OUT OF STOCK"
                : quantity <= minimum ? "LOW STOCK" : "AVAILABLE";

            model.addRow(new Object[]{
                rs.getInt("id"),
                rs.getString("item_name"),
                quantity,
                rs.getString("unit"),
                minimum,
                rs.getDouble("price"),
                date == null ? "" :
                    new java.text.SimpleDateFormat("MM-dd-yyyy").format(date),
                status
            });
        }

    } catch (SQLException e) {
        JOptionPane.showMessageDialog(this,
            "Error loading stock: " + e.getMessage());
    }
}
