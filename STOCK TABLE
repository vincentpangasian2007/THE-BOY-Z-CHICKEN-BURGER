    private void jButton2ActionPerformed(java.awt.event.ActionEvent evt) {                                         
int row = jTable1.getSelectedRow();

if(row == -1){
    JOptionPane.showMessageDialog(this,
        "Please select an item first.");
    return;
}

int id = Integer.parseInt(jTable1.getValueAt(row, 0).toString());

String item = JOptionPane.showInputDialog(
    this,
    "Enter new item name:",
    jTable1.getValueAt(row, 1)
);

if(item == null || item.trim().isEmpty()){
    return;
}

String qtyInput = JOptionPane.showInputDialog(
    this,
    "Enter new quantity:",
    jTable1.getValueAt(row, 2)
);

if(qtyInput == null || qtyInput.trim().isEmpty()){
    return;
}

String unit = JOptionPane.showInputDialog(
    this,
    "Enter unit:",
    jTable1.getValueAt(row, 3)
);

if(unit == null || unit.trim().isEmpty()){
    return;
}

String minInput = JOptionPane.showInputDialog(
    this,
    "Enter minimum stock:",
    jTable1.getValueAt(row, 4)
);

if(minInput == null || minInput.trim().isEmpty()){
    return;
}

String priceInput = JOptionPane.showInputDialog(
    this,
    "Enter price:",
    jTable1.getValueAt(row, 5)
);

if(priceInput == null || priceInput.trim().isEmpty()){
    return;
}

String dateInput = JOptionPane.showInputDialog(
    this,
    "Enter date (MM-DD-YYYY):",
    jTable1.getValueAt(row, 6)
);

if(dateInput == null || dateInput.trim().isEmpty()){
    return;
}

try{
    int qty = Integer.parseInt(qtyInput);
    int min = Integer.parseInt(minInput);
    double price = Double.parseDouble(priceInput);

    
java.text.SimpleDateFormat sdf =
    new java.text.SimpleDateFormat("MM-dd-yyyy");
sdf.setLenient(false);

java.sql.Date date = new java.sql.Date(
    sdf.parse(dateInput.trim()).getTime()
);

    Connection con = DatabaseConnection.getConnection();

    String sql = "UPDATE inventory SET item_name=?, quantity=?, unit=?, minimum_stock=?, price=?, date_added=? WHERE id=?";

    PreparedStatement pst = con.prepareStatement(sql);

    pst.setString(1, item);
    pst.setInt(2, qty);
    pst.setString(3, unit);
    pst.setInt(4, min);
    pst.setDouble(5, price);
    pst.setDate(6, date);
    pst.setInt(7, id);

    pst.executeUpdate();

    JOptionPane.showMessageDialog(this,
        "Item updated successfully!");

    pst.close();
    con.close();

    loadStock();

}catch(Exception e){
    JOptionPane.showMessageDialog(this,
        "Error: " + e.getMessage());
}
    }                                        

    private void btnAddStockActionPerformed(java.awt.event.ActionEvent evt) {                                            
int row = jTable1.getSelectedRow();

    if (row == -1) {
        JOptionPane.showMessageDialog(this, "Please select an item first.");
        return;
    }

    int id = Integer.parseInt(jTable1.getValueAt(row, 0).toString());

    String input = JOptionPane.showInputDialog(
    this, "Enter quantity to add:");
if (input == null || input.trim().isEmpty()) return;

String dateInput = JOptionPane.showInputDialog(
    this, "Enter date added (MM-DD-YYYY):");
if (dateInput == null || dateInput.trim().isEmpty()) return;

String expirationInput = JOptionPane.showInputDialog(
    this, "Enter expiration date (MM-DD-YYYY):");
if (expirationInput == null || expirationInput.trim().isEmpty()) return;


try {
    int addQty = Integer.parseInt(input.trim());

        if (addQty <= 0) {
            JOptionPane.showMessageDialog(this, "Enter a valid quantity.");
            return;
        }

        java.text.SimpleDateFormat sdf =
    new java.text.SimpleDateFormat("M-d-yyyy");
sdf.setLenient(false);

java.sql.Date newExpiration =
    new java.sql.Date(
        sdf.parse(expirationInput.trim()).getTime());

        try (Connection con = DatabaseConnection.getConnection()) {
            con.setAutoCommit(false);

            try {
                int previous;
                int current;

                String getSql =
                    "SELECT quantity FROM inventory WHERE id=? AND archived=0 FOR UPDATE";

                try (PreparedStatement ps = con.prepareStatement(getSql)) {
                    ps.setInt(1, id);

                    try (ResultSet rs = ps.executeQuery()) {
                        if (!rs.next()) {
                            throw new SQLException("Item not found.");
                        }
                        previous = rs.getInt("quantity");
                    }
                }

                current = previous + addQty;

                String updateSql =
    "UPDATE inventory SET quantity=? WHERE id=? AND archived=0";

try (PreparedStatement ps = con.prepareStatement(updateSql)) {
    ps.setInt(1, current);
    ps.setInt(2, id);
    ps.executeUpdate();
}

                String historySql =
    "INSERT INTO stock_history (inventory_id, previous_stock, stock_added, current_stock, date_added, expiration_date) VALUES (?, ?, ?, ?, ?, ?)";

                try (PreparedStatement ps = con.prepareStatement(historySql)) {
    ps.setInt(1, id);
    ps.setInt(2, previous);
    ps.setInt(3, addQty);
    ps.setInt(4, current);
    ps.setDate(5, new java.sql.Date(
        sdf.parse(dateInput.trim()).getTime()));
    ps.setDate(6, newExpiration);
    ps.executeUpdate();

}

                con.commit();

                JOptionPane.showMessageDialog(this,
                    "Stock added and expiration date saved!");

                loadStock();

            } catch (SQLException e) {
                con.rollback();
                throw e;
            } finally {
                con.setAutoCommit(true);
            }
        }
   } catch (IllegalArgumentException | SQLException | ParseException e) {
    JOptionPane.showMessageDialog(this,
        "Error: " + e.getMessage());
}

    }                                           

    private void btnArchiveActionPerformed(java.awt.event.ActionEvent evt) {                                           

    int row = jTable1.getSelectedRow();

    if (row == -1) {
        JOptionPane.showMessageDialog(this, "Please select an item first.");
        return;
    }

    int id = Integer.parseInt(jTable1.getValueAt(row, 0).toString());

    int confirm = JOptionPane.showConfirmDialog(
        this, "Archive this item?", "Confirm Archive",
        JOptionPane.YES_NO_OPTION
    );

    if (confirm != JOptionPane.YES_OPTION) return;

    String selectSql = "SELECT item_name, quantity, unit, minimum_stock, price, color, size, date_added FROM inventory WHERE id=? AND archived=0";

    String insertSql = "INSERT INTO stock_archive (item_name, quantity, unit, minimum_stock, price, color, size, date_added, archived_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, NOW())";

    String updateSql = "UPDATE inventory SET archived=1 WHERE id=? AND archived=0";

    try (Connection con = DatabaseConnection.getConnection()) {
        con.setAutoCommit(false);

        try {
            try (PreparedStatement ps = con.prepareStatement(selectSql)) {
                ps.setInt(1, id);

                try (ResultSet rs = ps.executeQuery()) {
                    if (!rs.next()) {
                        throw new SQLException("Active item not found.");
                    }

                    try (PreparedStatement ins = con.prepareStatement(insertSql)) {
                        ins.setString(1, rs.getString("item_name"));
                        ins.setInt(2, rs.getInt("quantity"));
                        ins.setString(3, rs.getString("unit"));
                        ins.setInt(4, rs.getInt("minimum_stock"));
                        ins.setDouble(5, rs.getDouble("price"));
                        ins.setString(6, rs.getString("color"));
                        ins.setString(7, rs.getString("size"));
                        ins.setDate(8, rs.getDate("date_added"));
                        ins.executeUpdate();
                    }
                }
            }

            try (PreparedStatement ps = con.prepareStatement(updateSql)) {
                ps.setInt(1, id);

                if (ps.executeUpdate() == 1) {
    JOptionPane.showMessageDialog(this,
        "Stock deducted successfully!");
}
            }

            con.commit();
            JOptionPane.showMessageDialog(this, "Item archived successfully!");
            loadStock();

        } catch (SQLException e) {
            con.rollback();
            throw e;
        } finally {
            con.setAutoCommit(true);
        }

    } catch (SQLException e) {
        JOptionPane.showMessageDialog(this, "Archive error: " + e.getMessage());
    }



    }                                          

