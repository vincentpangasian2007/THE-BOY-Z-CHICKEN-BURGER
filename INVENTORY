 public void loadDashboard() {
    String sql = "SELECT "
            + "COUNT(CASE WHEN archived = 0 THEN 1 END) AS total_items, "
            + "COUNT(CASE WHEN archived = 0 AND quantity > 0 THEN 1 END) AS available, "
            + "COUNT(CASE WHEN archived = 0 AND quantity > 0 "
            + "AND quantity <= minimum_stock THEN 1 END) AS low_stock, "
            + "COUNT(CASE WHEN archived = 1 THEN 1 END) AS archived "
            + "FROM inventory";

    try (
        Connection con = DatabaseConnection.getConnection();
        PreparedStatement ps = con.prepareStatement(sql);
        ResultSet rs = ps.executeQuery()
    ) {
        if (rs.next()) {
            lblTotalItems.setText(String.valueOf(rs.getInt("total_items")));
            lblAvailable.setText(String.valueOf(rs.getInt("available")));
            lblLowStock.setText(String.valueOf(rs.getInt("low_stock")));
            lblArchived.setText(String.valueOf(rs.getInt("archived")));
        }
    } catch (SQLException e) {
        JOptionPane.showMessageDialog(this,
                "Dashboard error: " + e.getMessage());
    }
}

