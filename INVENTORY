    private void btnAddActionPerformed(java.awt.event.ActionEvent evt) {                                       
String item = txtItemName.getText().trim();
    String qty = txtQuantity.getText().trim();
    String unit = cmbUnit.getSelectedItem().toString();
    String min = txtMinimum.getText().trim();
    String price = txtPrice.getText().trim();
    String date = txtDate.getText().trim();
    String expiration = txtExpirationDate.getText().trim();

    if (item.isEmpty() || qty.isEmpty() || min.isEmpty()
            || price.isEmpty() || date.isEmpty() || expiration.isEmpty()) {
        showMessage("Please complete all fields.", "WARNING");
        return;
    }

    try {
        int quantity = Integer.parseInt(qty);
        int minimum = Integer.parseInt(min);
        double itemPrice = Double.parseDouble(price);

        if (quantity < 0 || minimum < 0 || itemPrice < 0) {
            showMessage("Please enter valid numbers.", "WARNING");
            return;
        }

        java.text.SimpleDateFormat sdf =
                new java.text.SimpleDateFormat("d-M-yyyy");
        sdf.setLenient(false);

        java.sql.Date dateAdded =
                new java.sql.Date(sdf.parse(date).getTime());
        java.sql.Date expirationDate =
                new java.sql.Date(sdf.parse(expiration).getTime());

        try (Connection con = DatabaseConnection.getConnection()) {
            con.setAutoCommit(false);

            try {
                String checkSql =
                        "SELECT id FROM inventory WHERE LOWER(item_name)=LOWER(?)";

                try (PreparedStatement check = con.prepareStatement(checkSql)) {
                    check.setString(1, item);

                    try (ResultSet rs = check.executeQuery()) {
                        if (rs.next()) {
                            con.rollback();
                            showMessage("Item name already exists.", "WARNING");
                            return;
                        }
                    }
                }

                String sql = "INSERT INTO inventory "
                        + "(item_name, quantity, unit, minimum_stock, price, date_added, expiration_date, archived) "
                        + "VALUES (?, ?, ?, ?, ?, ?, ?, 0)";

                int inventoryId;

                try (PreparedStatement pst = con.prepareStatement(
                        sql, java.sql.Statement.RETURN_GENERATED_KEYS)) {

                    pst.setString(1, item);
                    pst.setInt(2, quantity);
                    pst.setString(3, unit);
                    pst.setInt(4, minimum);
                    pst.setDouble(5, itemPrice);
                    pst.setDate(6, dateAdded);
                    pst.setDate(7, expirationDate);

                    pst.executeUpdate();

                    try (ResultSet keys = pst.getGeneratedKeys()) {
                        if (!keys.next()) {
                            throw new SQLException("Could not get item ID.");
                        }
                        inventoryId = keys.getInt(1);
                    }
                }

                String historySql = "INSERT INTO stock_history "
                        + "(inventory_id, previous_stock, stock_added, "
                        + "current_stock, date_added, expiration_date) "
                        + "VALUES (?, ?, ?, ?, ?, ?)";

                try (PreparedStatement pst = con.prepareStatement(historySql)) {
                    pst.setInt(1, inventoryId);
                    pst.setInt(2, 0);
                    pst.setInt(3, quantity);
                    pst.setInt(4, quantity);
                    pst.setDate(5, dateAdded);
                    pst.setDate(6, expirationDate);
                    pst.executeUpdate();
                }

                con.commit();
                showMessage("Item added successfully!", "SUCCESS");

                txtItemName.setText("");
                txtQuantity.setText("");
                cmbUnit.setSelectedIndex(0);
                txtMinimum.setText("");
                txtPrice.setText("");
                txtDate.setText("");
                txtExpirationDate.setText("");

                loadDashboard();

            } catch (SQLException e) {
                con.rollback();
                throw e;
            } finally {
                con.setAutoCommit(true);
            }
        }
    } catch (NumberFormatException | SQLException | ParseException e) {
        showMessage("Error: " + e.getMessage(), "ERROR");
    }

    }                                      

