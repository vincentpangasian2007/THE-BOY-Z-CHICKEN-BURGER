    private void btnUnarchiveActionPerformed(java.awt.event.ActionEvent evt) {                                             
int row = jTable1.getSelectedRow();

    if (row == -1) {
        JOptionPane.showMessageDialog(this, "Please select an archived item.");
        return;
    }

    int id = Integer.parseInt(
        jTable1.getValueAt(row, 0).toString()
    );

    String sql = "UPDATE inventory SET archived = 0 WHERE id = ? AND archived = 1";

    try (Connection con = DatabaseConnection.getConnection();
         PreparedStatement ps = con.prepareStatement(sql)) {

        ps.setInt(1, id);

        int updated = ps.executeUpdate();

        if (updated > 0) {
            JOptionPane.showMessageDialog(this, "Item unarchived successfully!");
            loadArchivedStock();
        } else {
            JOptionPane.showMessageDialog(this, "Archived item not found.");
        }

    } catch (SQLException e) {
        JOptionPane.showMessageDialog(this, "Unarchive error: " + e.getMessage());
    }
    }                                            

