private void loadArchivedStock() {
    javax.swing.table.DefaultTableModel model =
        (javax.swing.table.DefaultTableModel) jTable1.getModel();

    model.setRowCount(0);

    String sql = "SELECT id, item_name, quantity, unit, minimum_stock, price, date_added "
           + "FROM inventory WHERE archived = 1";

    try (Connection con = DatabaseConnection.getConnection();
         PreparedStatement ps = con.prepareStatement(sql);
         ResultSet rs = ps.executeQuery()) {

        while (rs.next()) {
            model.addRow(new Object[]{
                rs.getInt("id"),
                rs.getString("item_name"),
                rs.getInt("quantity"),
                rs.getString("unit"),
                rs.getInt("minimum_stock"),
                rs.getDouble("price"),
                rs.getDate("date_added")
            });
        }

    } catch (SQLException e) {
        JOptionPane.showMessageDialog(this,
            "Loading archived stock failed: " + e.getMessage());
    }
}


    
private void btnUnarchiveActionPerformed() {
    int row = jTable1.getSelectedRow();

    if (row == -1) {
        JOptionPane.showMessageDialog(this,
            "Please select an archived item first.");
        return;
    }

    int id = Integer.parseInt(
        jTable1.getValueAt(row, 0).toString()
    );

    int confirm = JOptionPane.showConfirmDialog(
        this,
        "Restore this item to active inventory?",
        "Confirm Unarchive",
        JOptionPane.YES_NO_OPTION
    );

    if (confirm != JOptionPane.YES_OPTION) {
        return;
    }

    String sql = "UPDATE inventory SET archived = 0 WHERE id = ?";

    try (Connection con = DatabaseConnection.getConnection();
         PreparedStatement ps = con.prepareStatement(sql)) {

        ps.setInt(1, id);

        if (ps.executeUpdate() > 0) {
            JOptionPane.showMessageDialog(this,
                "Item restored successfully!");
            loadArchivedStock();
        } else {
            JOptionPane.showMessageDialog(this,
                "Item was not found.");
        }

    } catch (SQLException e) {
        JOptionPane.showMessageDialog(this,
            "Unarchive failed: " + e.getMessage());
    }
}


